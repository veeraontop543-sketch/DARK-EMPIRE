{
  "name": "discord-audio-dashboard",
  "version": "2.1.0",
  "description": "Premium Web Dashboard for Multi-Bot Discord Audio Management with Auth",
  "author": "Dark Empire",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "app": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "electronVersion": "30.0.0",
    "appId": "com.darkempire.bots",
    "productName": "Dark Empire Bots",
    "copyright": "Copyright © 2026 Dark Empire",
    "win": {
      "target": "nsis"
    },
    "files": [
      "electron-main.js",
      "public/**/*"
    ]
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "libsodium-wrappers": "^0.7.13",
    "opusscript": "^0.0.8",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.0"
